<IfModule mod_rewrite.c>
Options +FollowSymLinks
RewriteEngine On

# 1. Single-hop canonical domain and HTTPS normalization
# If request is for www (whether HTTP or HTTPS), redirect directly to apex domain in one hop
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# If non-www request is not HTTPS (checking native HTTPS and edge reverse-proxy SSL)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} ^(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 3. Prevent direct access to index.php (redirect /index.php to /)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[/?\s] [NC]
RewriteRule ^index\.php$ / [L,R=301]

# 4. Prevent direct /public/ access in URL (redirect /public/path to /path)
RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
RewriteRule ^ /%1 [L,R=301]

# 5. Redirect trailing slashes before rewriting into /public to prevent /public/ leak
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+(.+?)/+[?\s]
RewriteRule ^ /%1 [R=301,L]

# 6. Block access to .env and other sensitive files
<FilesMatch "^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Serve the database generated sitemap through Laravel even though an old
# static sitemap.xml file may still exist in the document root.
RewriteRule ^sitemap\.xml$ public/index.php [L]

# 7. Rewrite all requests into the public folder
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ public/$1 [L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(/)?$ public/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self' https: data:; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.quilljs.com https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.bunny.net https://cdn.quilljs.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://fonts.bunny.net data:; img-src 'self' data: https: blob:; connect-src 'self' https:; frame-src 'self' https:; upgrade-insecure-requests;"
</IfModule>
