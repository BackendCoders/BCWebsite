function generateCaptcha() {
    let num1 = Math.floor(Math.random() * 10);
    let num2 = Math.floor(Math.random() * 10);

    document.getElementById("captchaQuestion").innerHTML =
        `What is ${num1} + ${num2}? <span style="color:red">*</span>`;

    document.getElementById("captchaCorrect").value = num1 + num2;
}

const contactForm = document.querySelector("[data-contact-form]");

if (contactForm) {
  generateCaptcha();

  contactForm.addEventListener("submit", function(e) {

    let form = this;

    // Reset error
    document.getElementById("captchaError").classList.add("hidden");

    // HTML validation
    if (!form.checkValidity()) {
        e.preventDefault();
        form.reportValidity();
        return;
    }

    // CAPTCHA validation
    let userAnswer = document.getElementById("captchaInput").value.trim();
    let correctAnswer = document.getElementById("captchaCorrect").value;

    if (userAnswer == "" || userAnswer != correctAnswer) {
        e.preventDefault();

        document.getElementById("captchaError").classList.remove("hidden");

        generateCaptcha();
        document.getElementById("captchaInput").value = "";
    }
  });
}


document.addEventListener("DOMContentLoaded", function () {

    const counters = document.querySelectorAll('.counter');

    const runCounter = (counter) => {
        const target = +counter.getAttribute('data-target');
        let count = 0;

        const update = () => {
            const increment = target / 100;
            count += increment;

            if (count < target) {
                counter.innerText = Math.ceil(count);
                requestAnimationFrame(update);
            } else {
                counter.innerText = target;
            }
        };

        update();
    };

    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                runCounter(entry.target);
                observer.unobserve(entry.target);
            }
        });
    });

    counters.forEach(counter => observer.observe(counter));

});



// hero grid
document.querySelectorAll('.video-card').forEach(card=>{

    let loadingPromise = null;
    let isHovered = false;

    const getImage = () => card.querySelector('img');
    const getVideo = () => card.querySelector('video');
    const showImage = () => {
        const image = getImage();
        if (image) {
            image.style.opacity = 1;
        }
    };
    const hideImage = () => {
        const image = getImage();
        if (image) {
            image.style.opacity = 0;
        }
    };

    const createVideo = async () => {
        const videoUrl = card.dataset.videoUrl;
        const fallbackUrl = card.dataset.videoFallback;

        if (!videoUrl && !fallbackUrl) {
            return null;
        }

        const video = document.createElement('video');
        let source = fallbackUrl || '';

        if (videoUrl) {
            try {
                const response = await fetch(videoUrl, {
                    headers: {
                        'Accept': 'application/json',
                    },
                    credentials: 'same-origin',
                });

                if (response.ok) {
                    const json = await response.json();
                    source = json?.data?.url || source;
                }
            } catch (error) {
                // Fall back to the direct mp4 source when the API is unavailable on live.
            }
        }

        if (!source) {
            return null;
        }

        video.src = source;
        video.autoplay = true;
        video.loop = true;
        video.muted = true;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.preload = 'auto';
        video.className = 'absolute inset-0 z-10 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out';
        video.setAttribute('aria-hidden', 'true');

        card.appendChild(video);
        video.load();
        return video;
    };

    card.addEventListener('mouseenter',async()=>{
        isHovered = true;

        const existingVideo = getVideo();

        if (existingVideo) {
            hideImage();
            existingVideo.style.opacity = 1;

            try {
                await existingVideo.play();
            } catch (error) {
                // Muted inline autoplay should normally work, but ignore any browser-specific rejection.
            }

            return;
        }

        if (!loadingPromise) {
            loadingPromise = createVideo().finally(() => {
                loadingPromise = null;
            });
        }

        let video = null;

        try {
            video = await loadingPromise;
        } catch (error) {
            return;
        }

        if (!video || !isHovered) {
            showImage();
            if (video) {
                video.style.opacity = 0;
                video.pause();
            }
            return;
        }

        hideImage();
        video.style.opacity = 1;

        try {
            await new Promise(resolve => requestAnimationFrame(resolve));
            await video.play();
        } catch (error) {
            showImage();
        }

    });

    card.addEventListener('mouseleave',()=>{
        isHovered = false;

        const video = getVideo();

        if(video){

            video.pause();

            video.style.opacity = 0;

        }

        showImage();

    });

});
</script>




<!-- Lazy-load AOS during idle or on first interaction to avoid render blocking -->
<script>
  (function(){
    function loadScript(src, cb){
      var s = document.createElement('script');
      s.src = src; s.async = true; s.onload = cb; s.onerror = cb; document.head.appendChild(s);
    }

    function loadLibs(){
      if(window._perfLibsLoaded) return;
      // AOS: init after loaded
      loadScript('https://unpkg.com/aos@2.3.4/dist/aos.js', function(){
        if(window.AOS && typeof AOS.init === 'function'){
          AOS.init({ once: true, duration: 750, easing: 'ease-out-cubic' });
        }
      });

      window._perfLibsLoaded = true;
    }

    if('requestIdleCallback' in window){
      requestIdleCallback(function(){ setTimeout(loadLibs, 200); }, {timeout:2000});
    } else {
      window.addEventListener('load', function(){ setTimeout(loadLibs, 200); });
    }

    ['click','keydown','scroll','touchstart'].forEach(function(ev){
      document.addEventListener(ev, loadLibs, {once:true, passive:true});
    });
  })();
</script>


